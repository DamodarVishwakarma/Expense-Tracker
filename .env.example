# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file or real secrets to version control.

# Secret key used to sign JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_NAME=Expense Manager API
# Local SQLite default. For AWS RDS PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///app/db/app.db
CORS_ORIGINS=http://localhost:3000
